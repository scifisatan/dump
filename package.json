    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "sonner": "2.0.8",
