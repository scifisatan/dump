{
  "name": "dump",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.json",
    "preview": "vite preview --host 127.0.0.1 --port 6192 --strictPort",
    "build:test": "vite build --mode test",
    "deploy": "node scripts/deploy.mjs",
    "typegen": "wrangler types",
    "lint": "oxlint -c .oxlintrc.jsonc src tests scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build"
  },
