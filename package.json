{
  "name": "dump",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel web",
    "scratch": "vp run scratch:server",
    "dump": "node cli/dump.mjs",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vp build",
    "build:server": "wrangler deploy --dry-run --outdir dist/server",
    "mac:engine": "node mac/engine/build.mjs",
    "mac:build": "mac/scripts/build-app.sh",
    "mac:install": "mac/scripts/build-app.sh --install",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.json && tsc -p mac/engine/tsconfig.json && tsc -p cli/tsconfig.json && tsc -p tests/tsconfig.json",
    "preview": "vp preview",
    "typegen": "wrangler types",
    "format": "vp fmt",
    "lint": "vp lint",
    "test": "vp test",
    "test:e2e": "playwright test",
    "check": "vp check && vp test && npm run build",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.11",
    "@astryxdesign/theme-matcha": "0.7.11",
    "@fontsource-variable/geist": "5.3.0",
    "@stylexjs/stylex": "0.19.1",
    "clsx": "2.1.1",
    "hono": "4.13.8",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tinybase": "9.7.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.11",
    "@cloudflare/workers-types": "5.20260920.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "core-js": "3.50.0",
    "oxlint-plugin-react-doctor": "0.9.14",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plugin-pwa": "1.3.0",
    "vite-plus": "0.3.3",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vitest": "4.1.11"
  }
}
