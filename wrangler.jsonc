// The API server: one Worker and one SQLite-backed Durable Object per owner. It serves no UI.
// Everyone uses the hosted web app at https://dump.abishrestha.com.np (wrangler.client.jsonc)
// and enters their own server's address. Forks keep that origin in ALLOWED_CLIENT_ORIGINS.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dump",
  "account_id": "9ec33c0e13474b34877b41fcad911a1a",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "dump-api.abishrestha.com.np", "custom_domain": true }],
  "vars": { "ALLOWED_CLIENT_ORIGINS": "https://dump.abishrestha.com.np" },
  "durable_objects": {
    "bindings": [{ "name": "DUMP", "class_name": "DumpDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DumpDO"] }],
  "observability": { "enabled": true },
}
