{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dump",
  "account_id": "9ec33c0e13474b34877b41fcad911a1a",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "dump.abishrestha.com.np", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "DUMP", "class_name": "DumpDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DumpDO"] }],
  "observability": { "enabled": true },
}
